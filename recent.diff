diff --git a/compiler/rustc_expand_meta_macros/src/lib.rs b/compiler/rustc_expand_meta_macros/src/lib.rs
new file mode 100644
index 00000000000..3af6cd377c9
--- /dev/null
+++ b/compiler/rustc_expand_meta_macros/src/lib.rs
@@ -0,0 +1,47 @@
+// This crate defines meta-macros for abstracting complex types and generics
+// in the `rustc_expand` crate, enabling a "lisp-like card system" for type definitions.
+
+// The define_type_system! meta-macro generates other helper macros.
+// These helper macros are designed to simplify the declaration and usage
+// of complex types within `rustc_expand`.
+#[macro_export]
+macro_rules! define_type_system {
+    () => {
+        // CollectorSpecial! abstracts the InvocationCollector type.
+        // It takes type parameters which are then passed to the underlying InvocationCollector.
+        macro_rules! CollectorSpecial {
+            ($($p:tt)*) => { InvocationCollector<$($p)*> };
+        }
+
+        // CtxSpecial! abstracts the RefAMutExpandContext_B_DRT type.
+        // It takes type parameters which are then passed to the underlying RefAMutExpandContext_B_DRT.
+        macro_rules! CtxSpecial {
+            ($($p:tt)*) => { RefAMutExpandContext_B_DRT<$($p)*> };
+        }
+
+        // ExpanderStruct! generates the MacroExpander struct definition.
+        // It uses CtxSpecial! to define the type of the `cx` field,
+        // thereby abstracting away the explicit generics on the struct itself.
+        macro_rules! ExpanderStruct {
+            () => {
+                pub struct MacroExpander {
+                    // Lifetimes and DRT are implicitly captured or inferred from the usage context
+                    // of CtxSpecial! and the surrounding impl block.
+                    cx: CtxSpecial!('a, 'b, DRT),
+                    monotonic: bool,
+                }
+            };
+        }
+
+        // This macro wraps the contents of the impl MacroExpander block,
+        // implicitly adding the necessary generics and trait bounds.
+        macro_rules! impl_for_macro_expander {
+            ($($body:tt)*) => {
+                impl<'a, 'b, DRT: OpaqueDeriveResolution + 'static> MacroExpander<'a, 'b, DRT> {
+                    $($body)*
+                }
+            };
+        }
+
+    };
+}
