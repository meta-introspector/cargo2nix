@@ -0,0 +1,40 @@
+use std::{env, fs, path::PathBuf};
+
+fn main() {
+    let out_dir = PathBuf::from(env::var("OUT_DIR").unwrap());
+    let dest_path = out_dir.join("lib.rs"); // This will be the generated lib.rs
+
+    let mut generated_mods = String::new();
+    let src_meta_macros_defs_dir = PathBuf::from(env::var("CARGO_MANIFEST_DIR").unwrap()).join("src/meta_macros_defs");
+
+    eprintln!("--- rustc_expand_meta_macros build.rs running ---");
+    eprintln!("Generating pub mod statements for directory: {}", src_meta_macros_defs_dir.display());
+
+    if let Ok(entries) = fs::read_dir(&src_meta_macros_defs_dir) {
+        let mut module_names: Vec<String> = entries
+            .filter_map(|entry| entry.ok())
+            .filter(|entry| entry.path().is_file())
+            .filter_map(|entry| entry.path().file_stem().and_then(|s| s.to_str()).map(|s| s.to_string()))
+            .filter(|name| name != "mod") // Don't create a pub mod for mod.rs itself
+            .collect();
+
+        // Sort to ensure consistent output order
+        module_names.sort();
+
+        for module_name in module_names {
+            generated_mods.push_str(&format!("pub mod {};\n", module_name));
+        }
+    }
+
+    // Write the generated pub mod statements to OUT_DIR/lib.rs
+    fs::write(&dest_path, &generated_mods).unwrap();
+
+    eprintln!("--- Generated lib.rs content ---");
+    eprintln!("{}", generated_mods);
+    eprintln!("--- End of generated lib.rs content ---");
+
+    // Invalidate the build if the src/meta_macros_defs directory changes
+    println!("cargo:rerun-if-changed=src/meta_macros_defs");
+    // Also invalidate if build.rs itself changes
+    println!("cargo:rerun-if-changed=build.rs");
+}
