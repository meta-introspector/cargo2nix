diff --git a/compiler/rustc_expand_base_lib/build.rs b/compiler/rustc_expand_base_lib/build.rs
new file mode 100644
index 00000000000..78255caac59
--- /dev/null
+++ b/compiler/rustc_expand_base_lib/build.rs
@@ -0,0 +1,119 @@
+use std::{env, fs, path::{Path, PathBuf}};
+use syn::{parse_file, Item, Ident as SynIdent};
+use quote::quote;
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    println!("cargo:rerun-if-changed=build.rs");
+
+    let out_dir = PathBuf::from(env::var("OUT_DIR")?);
+    let manifest_dir = PathBuf::from(env::var("CARGO_MANIFEST_DIR")?);
+    let src_dir = manifest_dir.join("src");
+
+    fs::create_dir_all(&out_dir)?;
+
+    let mut generated_lib_rs_content = String::new();
+
+    // Generate macro definitions
+    generated_lib_rs_content.push_str(r#"`
+        macro_rules! wrap_fn {
+            ($($item:item)*) => {
+                $( 
+                    eprintln!("Wrapped item: fn {}", stringify!($item));
+                    $item
+                )*
+            };
+        }
+
+        macro_rules! wrap_struct {
+            ($($item:item)*) => {
+                $( 
+                    eprintln!("Wrapped item: struct {}", stringify!($item));
+                    $item
+                )*
+            };
+        }
+
+        macro_rules! wrap_enum {
+            ($($item:item)*) => {
+                $( 
+                    eprintln!("Wrapped item: enum {}", stringify!($item));
+                    $item
+                )*
+            };
+        }
+
+        macro_rules! wrap_trait {
+            ($($item:item)*) => {
+                $( 
+                    eprintln!("Wrapped item: trait {}", stringify!($item));
+                    $item
+                )*
+            };
+        }
+
+        macro_rules! wrap_impl {
+            ($($item:item)*) => {
+                $( 
+                    eprintln!("Wrapped item: impl {}", stringify!($item));
+                    $item
+                )*
+            };
+        }
+
+        // Catch-all for other items
+        macro_rules! wrap_item {
+            ($($item:item)*) => {
+                $( 
+                    eprintln!("Wrapped item: item {}", stringify!($item));
+                    $item
+                )*
+            };
+        }
+    `#);
+
+    let mut all_transformed_file_paths = Vec::new();
+
+    for entry in fs::read_dir(&src_dir)? {
+        let entry = entry?;
+        let path = entry.path();
+
+        if path.is_file() && path.extension().map_or(false, |ext| ext == "rs") {
+            println!("cargo:rerun-if-changed={}", path.display());
+            let original_code = fs::read_to_string(&path)?;
+            let file_stem = path.file_stem().ok_or("No file stem")?.to_string_lossy();
+
+            let ast = parse_file(&original_code)?;
+            let mut transformed_items = Vec::new();
+
+            for item in ast.items {
+                let wrapped_item = match item {
+                    Item::Fn(item_fn) => quote! { wrap_fn! { #item_fn } },
+                    Item::Struct(item_struct) => quote! { wrap_struct! { #item_struct } },
+                    Item::Enum(item_enum) => quote! { wrap_enum! { #item_enum } },
+                    Item::Trait(item_trait) => quote! { wrap_trait! { #item_trait } },
+                    Item::Impl(item_impl) => quote! { wrap_impl! { #item_impl } },
+                    // Handle other item types with a generic wrap_item or specific ones as needed
+                    _ => quote! { wrap_item! { #item } },
+                };
+                transformed_items.push(wrapped_item);
+            }
+
+            let transformed_file_content = quote! {
+                #(#transformed_items)*
+            }.to_string();
+
+
+            let output_file_name = format!("transformed_{}.rs", file_stem);
+            let output_path = out_dir.join(&output_file_name);
+            fs::write(&output_path, transformed_file_content)?;
+            all_transformed_file_paths.push(output_path);
+        }
+    }
+
+    for transformed_path in &all_transformed_file_paths {
+        generated_lib_rs_content.push_str(&format!("include!(\"{}\");\n", transformed_path.display()));
+    }
+    fs::write(out_dir.join("lib.rs"), generated_lib_rs_content)?;
+
+    Ok(())
+}
